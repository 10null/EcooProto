create table if not exists public.ecopavle_contact_requests (
  id uuid primary key default gen_random_uuid(),
  full_name text not null,
  organization text,
  role_title text,
  email text not null,
  phone text,
  project_type text not null,
  message text not null,
  consent_habeas_data boolean not null default false,
  status text not null default 'nuevo',
  created_at timestamptz not null default now()
);

create index if not exists ecopavle_contact_requests_created_at_idx
  on public.ecopavle_contact_requests (created_at desc);

alter table public.ecopavle_contact_requests enable row level security;

create policy "ecopavle_solicitudes_insert_publico"
on public.ecopavle_contact_requests
for insert
to anon, authenticated
with check (
  consent_habeas_data
  and char_length(btrim(full_name)) between 2 and 120
  and char_length(btrim(email)) between 5 and 160
  and position('@' in email) > 1
  and char_length(btrim(project_type)) between 2 and 60
  and char_length(btrim(message)) between 10 and 2000
  and status = 'nuevo'
);